# ARVA.id — React single-page app on Apache (IONOS).
# Any address that is not a real file or folder is served index.html,
# so links like /portfolio or /capabilities work when opened directly or refreshed.
Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# Long cache for hashed build assets, no cache for the HTML shell.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|jpg|jpeg|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
